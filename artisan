if (PHP_SAPI !== 'cli') {
    http_response_code(404);
    exit;
}

define('ROOT', __DIR__);

// ===== Màu cho terminal =====
function c(string $text, string $color): string
{
    $codes = [
        'red' => '0;31', 'green' => '0;32', 'yellow' => '0;33',
        'blue' => '0;34', 'cyan'  => '0;36', 'gray'   => '0;90',
        'bold' => '1',
    ];
    if (!isset($codes[$color])) {
        return $text;
    }
    return "\033[{$codes[$color]}m{$text}\033[0m";
}

function info(string $m): void  { echo c('  ' . $m, 'cyan')   . PHP_EOL; }
function ok(string $m): void    { echo c('  ✔ ' . $m, 'green') . PHP_EOL; }
function warn(string $m): void  { echo c('  ! ' . $m, 'yellow') . PHP_EOL; }
function fail(string $m): void  { echo c('  ✘ ' . $m, 'red')   . PHP_EOL; }

// ===== Nạp cấu hình DB =====
function loadEnv(): void
{
    $env = ROOT . '/Backend/commons/env.php';
    $sample = ROOT . '/Backend/commons/env.example.php';

    if (!file_exists($env)) {
        if (!file_exists($sample)) {
            fail('Không tìm thấy Backend/commons/env.example.php');
            exit(1);
        }
        copy($sample, $env);
        warn('Chưa có env.php — đã tạo tự động từ env.example.php');
    }

    // env.php đọc $_SERVER['SCRIPT_NAME'] để tính BASE_PATH; ở CLI thì giả lập.
    $_SERVER['SCRIPT_NAME'] = $_SERVER['SCRIPT_NAME'] ?? '/index.php';
    require_once $env;
}

// ===== Kết nối MySQL =====
function db(bool $withDatabase = true): PDO
{
    loadEnv();

    $dsn = 'mysql:host=' . DB_HOST . ';port=' . DB_PORT . ';charset=utf8mb4';
    if ($withDatabase) {
        $dsn = 'mysql:host=' . DB_HOST . ';port=' . DB_PORT
             . ';dbname=' . DB_NAME . ';charset=utf8mb4';
    }

    try {
        return new PDO($dsn, DB_USERNAME, DB_PASSWORD, [
            PDO::ATTR_ERRMODE => PDO::ERRMODE_EXCEPTION,
        ]);
    } catch (PDOException $e) {
        fail('Không kết nối được MySQL: ' . $e->getMessage());
        warn('Kiểm tra: Laragon/XAMPP đã bật MySQL chưa?');
        exit(1);
    }
}

/**
 * Chạy 1 file .sql. Tách câu lệnh theo dấu `;` ở cuối dòng — đủ dùng cho
 * các file schema/seed của dự án (không có stored procedure).
 */
function runSqlFile(PDO $pdo, string $path): int
{
    if (!file_exists($path)) {
        warn('Bỏ qua (không tồn tại): ' . basename($path));
        return 0;
    }

    $sql = file_get_contents($path);

    // Bỏ comment dòng `-- ...`
    $sql = preg_replace('/^\s*--.*$/m', '', $sql);

    $statements = array_filter(
        array_map('trim', preg_split('/;\s*[\r\n]/', $sql)),
        fn($s) => $s !== '' && $s !== ';'
    );

    $count = 0;
    foreach ($statements as $stmt) {
        try {
            $pdo->exec($stmt);
            $count++;
        } catch (PDOException $e) {
            fail(basename($path) . ' → ' . $e->getMessage());
            exit(1);
        }
    }

    ok(basename($path) . c("  ({$count} câu lệnh)", 'gray'));
    return $count;
}

/** Danh sách file SQL theo đúng thứ tự phụ thuộc. */
function sqlFiles(bool $includeSeed = true): array
{
    $files = [ROOT . '/Backend/sql/schema.sql'];

    if ($includeSeed) {
        $files[] = ROOT . '/Backend/sql/seed.sql';
    }

    $files[] = ROOT . '/Backend/sql/addresses.sql';
    $files[] = ROOT . '/Backend/sql/misc_tables.sql';
    $files[] = ROOT . '/Backend/sql/security_tables.sql';
    $files[] = ROOT . '/Backend/sql/voucher.sql';

    if ($includeSeed) {
        $files[] = ROOT . '/Backend/add_variants.sql';
    }

    return $files;
}

/** Cổng đang bị chiếm? */
function portBusy(string $host, int $port): bool
{
    $sock = @fsockopen($host, $port, $errno, $errstr, 0.4);
    if ($sock) {
        fclose($sock);
        return true;
    }
    return false;
}

// =====================================================================
//  CÁC LỆNH
// =====================================================================

function cmdServe(array $args): int
{
    $host = 'localhost';
    $port = 8000;

    foreach ($args as $a) {
        if (preg_match('/^--port=(\d+)$/', $a, $m))  { $port = (int)$m[1]; }
        if (preg_match('/^--host=(.+)$/', $a, $m))   { $host = $m[1]; }
    }

    loadEnv();

    while (portBusy($host, $port) && $port < 8020) {
        warn("Cổng {$port} đang bận, thử cổng " . ($port + 1) . '...');
        $port++;
    }

    $url = "http://{$host}:{$port}";

    echo PHP_EOL;
    echo c('  HDTT Store', 'bold') . c('  —  development server', 'gray') . PHP_EOL;
    echo c('  ─────────────────────────────────────────────', 'gray') . PHP_EOL;
    echo '  Địa chỉ:  ' . c($url, 'cyan') . PHP_EOL;
    echo '  Admin:    ' . c($url . '/index.php?act=login', 'cyan') . PHP_EOL;
    echo '  Database: ' . c(DB_NAME . ' @ ' . DB_HOST . ':' . DB_PORT, 'gray') . PHP_EOL;
    echo c('  ─────────────────────────────────────────────', 'gray') . PHP_EOL;
    echo c('  Nhấn Ctrl+C để dừng.', 'gray') . PHP_EOL . PHP_EOL;

    $cmd = escapeshellarg(PHP_BINARY)
         . ' -S ' . escapeshellarg("{$host}:{$port}")
         . ' -t ' . escapeshellarg(ROOT);

    passthru($cmd, $exitCode);
    return $exitCode;
}

function cmdMigrate(array $args): int
{
    $fresh = in_array('--fresh', $args, true);
    $seed  = !in_array('--no-seed', $args, true);

    loadEnv();

    if ($fresh) {
        $pdo = db(false);
        warn('Đang XOÁ và tạo lại database `' . DB_NAME . '`...');
        $pdo->exec('DROP DATABASE IF EXISTS `' . DB_NAME . '`');
        $pdo->exec('CREATE DATABASE `' . DB_NAME . '` '
                 . 'DEFAULT CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci');
        ok('Đã tạo lại database');
    }

    // schema.sql tự CREATE DATABASE nên kết nối không kèm dbname trước.
    $pdo = db(false);
    $pdo->exec('CREATE DATABASE IF NOT EXISTS `' . DB_NAME . '` '
             . 'DEFAULT CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci');
    $pdo->exec('USE `' . DB_NAME . '`');

    info('Đang import SQL vào `' . DB_NAME . '`:');
    foreach (sqlFiles($seed) as $file) {
        runSqlFile($pdo, $file);
    }

    echo PHP_EOL;
    ok('Migrate xong.');

    if ($seed) {
        echo PHP_EOL;
        info('Tài khoản mẫu (ô đăng nhập nhập EMAIL):');
        echo '    admin@hdtt.local  /  admin123   ' . c('(quản trị)', 'gray') . PHP_EOL;
        echo '    khach@hdtt.local  /  user123    ' . c('(khách hàng)', 'gray') . PHP_EOL;
    }

    return 0;
}

function cmdSeed(array $args): int
{
    $pdo = db();
    info('Đang nạp dữ liệu mẫu:');
    runSqlFile($pdo, ROOT . '/Backend/sql/seed.sql');
    runSqlFile($pdo, ROOT . '/Backend/add_variants.sql');
    ok('Seed xong.');
    return 0;
}

function cmdRouteList(array $args): int
{
    $index = file_get_contents(ROOT . '/index.php');
    preg_match_all("/case\s+'([a-zA-Z_]+)'\s*:/", $index, $m);

    $routes = array_values(array_unique($m[1]));

    echo PHP_EOL;
    echo '  ' . c(str_pad('URL', 46) . 'ROUTE', 'bold') . PHP_EOL;
    echo c('  ' . str_repeat('─', 62), 'gray') . PHP_EOL;

    foreach ($routes as $r) {
        $url = '/index.php?act=' . $r;
        echo '  ' . str_pad($url, 46) . c($r, 'cyan') . PHP_EOL;
    }

    echo c('  ' . str_repeat('─', 62), 'gray') . PHP_EOL;
    echo '  ' . c(count($routes) . ' route', 'gray') . PHP_EOL . PHP_EOL;

    return 0;
}

function cmdDbStatus(array $args): int
{
    $pdo = db();
    $tables = $pdo->query('SHOW TABLES')->fetchAll(PDO::FETCH_COLUMN);

    echo PHP_EOL;
    echo '  Database: ' . c(DB_NAME, 'cyan') . PHP_EOL;
    echo c('  ' . str_repeat('─', 40), 'gray') . PHP_EOL;

    foreach ($tables as $t) {
        $n = $pdo->query('SELECT COUNT(*) FROM `' . $t . '`')->fetchColumn();
        echo '  ' . str_pad($t, 24) . c(str_pad((string)$n, 8, ' ', STR_PAD_LEFT) . ' dòng', 'gray') . PHP_EOL;
    }

    echo c('  ' . str_repeat('─', 40), 'gray') . PHP_EOL;
    echo '  ' . c(count($tables) . ' bảng', 'gray') . PHP_EOL . PHP_EOL;

    return 0;
}

function cmdList(array $args): int
{
    echo PHP_EOL;
    echo c('  HDTT Store', 'bold') . c('  —  console tool (không phải Laravel)', 'gray') . PHP_EOL . PHP_EOL;
    echo c('  Cách dùng:', 'yellow') . '  php artisan <lệnh> [tuỳ chọn]' . PHP_EOL . PHP_EOL;
    echo c('  Lệnh có sẵn:', 'yellow') . PHP_EOL;

    $rows = [
        ['serve',          'Khởi động web server (alias: ser, s)'],
        ['  --port=8080',  'Đổi cổng (mặc định 8000)'],
        ['migrate',        'Tạo bảng + nạp dữ liệu mẫu'],
        ['migrate:fresh',  'XOÁ sạch database rồi tạo lại từ đầu'],
        ['db:seed',        'Chỉ nạp lại dữ liệu mẫu'],
        ['db:status',      'Xem các bảng và số dòng'],
        ['route:list',     'Liệt kê toàn bộ route của web'],
        ['list',           'Hiện bảng trợ giúp này'],
    ];

    foreach ($rows as [$cmd, $desc]) {
        echo '    ' . c(str_pad($cmd, 18), 'green') . c($desc, 'gray') . PHP_EOL;
    }

    echo PHP_EOL;
    echo c('  Frontend:', 'yellow') . '  npm run dev' . c('   (chạy server + xem log)', 'gray') . PHP_EOL;
    echo PHP_EOL;

    return 0;
}

// =====================================================================
//  ĐIỀU HƯỚNG
// =====================================================================

$argv    = $_SERVER['argv'];
$command = $argv[1] ?? 'list';
$args    = array_slice($argv, 2);

// Cho phép viết tắt — `ser`, `serv`, `s` đều ra `serve`
$aliases = [
    's' => 'serve', 'se' => 'serve', 'ser' => 'serve',
    'serv' => 'serve', 'server' => 'serve', 'start' => 'serve',
    'mig' => 'migrate', 'migrate:refresh' => 'migrate:fresh',
    'seed' => 'db:seed', 'routes' => 'route:list',
    'help' => 'list', '--help' => 'list', '-h' => 'list',
];
$command = $aliases[$command] ?? $command;

switch ($command) {
    case 'serve':
        exit(cmdServe($args));

    case 'migrate':
        exit(cmdMigrate($args));

    case 'migrate:fresh':
        exit(cmdMigrate(array_merge($args, ['--fresh'])));

    case 'db:seed':
        exit(cmdSeed($args));

    case 'db:status':
        exit(cmdDbStatus($args));

    case 'route:list':
        exit(cmdRouteList($args));

    case 'list':
        exit(cmdList($args));

    default:
        fail('Không có lệnh "' . $command . '".');
        cmdList([]);
        exit(1);
}
